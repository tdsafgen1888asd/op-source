diff --git a/package/kernel/mac80211/patches/build/230-backports-handle-sockaddr-unsized-stable-backport.patch b/package/kernel/mac80211/patches/build/230-backports-handle-sockaddr-unsized-stable-backport.patch
new file mode 100644
index 00000000..9c51e412
--- /dev/null
+++ b/package/kernel/mac80211/patches/build/230-backports-handle-sockaddr-unsized-stable-backport.patch
@@ -0,0 +1,31 @@
+From: op-source maintainers
+Subject: [PATCH] backports: handle the temporary sockaddr_unsized stable backport
+
+Linux 6.18.57 through 6.18.60 provided struct sockaddr_unsized in the
+kernel headers. Stable commit 9d275d40b6ec reverted that socket API
+backport in 6.18.61, removing the structure from the 6.18.y kernel.
+
+Keep the compatibility definition for 6.18.61 and later 6.18.y releases
+and suppress it only where the kernel already provides the structure.
+
+--- a/backport-include/linux/socket.h
++++ b/backport-include/linux/socket.h
+@@ -11,7 +11,8 @@
+ #define SOL_NFC		280
+ #endif
+ 
+-#if LINUX_VERSION_IS_LESS(6,19,0)
++#if LINUX_VERSION_IS_LESS(6,19,0) && \
++    (LINUX_VERSION_IS_LESS(6,18,57) || !LINUX_VERSION_IS_LESS(6,18,61))
+ /**
+  * struct sockaddr_unsized - Unspecified size sockaddr for callbacks
+  * @sa_family: Address family (AF_UNIX, AF_INET, AF_INET6, etc.)
+@@ -28,7 +29,7 @@ struct sockaddr_unsized {
+ 	__kernel_sa_family_t	sa_family;	/* address family, AF_xxx */
+ 	char			sa_data[];	/* flexible address data */
+ };
+-#endif /* < 6.19 */
++#endif /* < 6.19, except 6.18.57 through 6.18.60 */
+ 
+ #ifndef __sockaddr_check_size
+ #define __sockaddr_check_size(size)	\
diff --git a/package/kernel/mac80211/patches/subsys/380-p54-validate-firmware-record-lengths.patch b/package/kernel/mac80211/patches/subsys/380-p54-validate-firmware-record-lengths.patch
new file mode 100644
index 00000000..84ee1810
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/380-p54-validate-firmware-record-lengths.patch
@@ -0,0 +1,78 @@
+From: Heyang Tan <thy15333007817@163.com>
+Subject: [PATCH] wifi: p54: validate firmware record lengths
+
+Backport upstream db7b86bd97b380ece8fa39cfdd7502a9fd35e56f, included in
+Linux 6.18.59 as f641066b0ddcd1b0cf007c0d04f9c966f6e888ae, into the
+separately built backports 7.2 package. Validate component record lengths
+and descriptor RX bounds before reading data or updating driver state.
+
+CVE: CVE-2026-99100
+Upstream: https://git.kernel.org/stable/c/f641066b0ddcd1b0cf007c0d04f9c966f6e888ae
+Signed-off-by: Heyang Tan <thy15333007817@163.com>
+Tested-by: Christian Lamparter <chunkeey@gmail.com>
+Signed-off-by: Johannes Berg <johannes.berg@intel.com>
+Signed-off-by: Greg Kroah-Hartman <gregkh@linuxfoundation.org>
+---
+--- a/drivers/net/wireless/intersil/p54/fwio.c
++++ b/drivers/net/wireless/intersil/p54/fwio.c
+@@ -52,6 +52,13 @@
+ 		u32 code = le32_to_cpu(bootrec->code);
+ 		switch (code) {
+ 		case BR_CODE_COMPONENT_ID:
++			if (len < sizeof(struct bootrec_comp_id) /
++				sizeof(*bootrec->data)) {
++				wiphy_err(priv->hw->wiphy,
++					  "firmware component ID is too short\n");
++				return -EINVAL;
++			}
++
+ 			priv->fw_interface = be32_to_cpup((__be32 *)
+ 					     bootrec->data);
+ 			switch (priv->fw_interface) {
+@@ -72,16 +79,41 @@
+ 			}
+ 			break;
+ 		case BR_CODE_COMPONENT_VERSION:
++			if (len < DIV_ROUND_UP(sizeof(struct bootrec_comp_ver),
++					       sizeof(*bootrec->data))) {
++				wiphy_err(priv->hw->wiphy,
++					  "firmware component version is too short\n");
++				return -EINVAL;
++			}
++
+ 			/* 24 bytes should be enough for all firmwares */
+-			if (strnlen((unsigned char *) bootrec->data, 24) < 24)
+-				fw_version = (unsigned char *) bootrec->data;
++			if (strnlen((unsigned char *)bootrec->data,
++				    sizeof(struct bootrec_comp_ver)) <
++				    sizeof(struct bootrec_comp_ver))
++				fw_version = (unsigned char *)bootrec->data;
+ 			break;
+ 		case BR_CODE_DESCR: {
+ 			struct bootrec_desc *desc =
+ 				(struct bootrec_desc *)bootrec->data;
+-			priv->rx_start = le32_to_cpu(desc->rx_start);
+-			/* FIXME add sanity checking */
+-			priv->rx_end = le32_to_cpu(desc->rx_end) - 0x3500;
++			u32 rx_start, rx_end;
++
++			/* 0xa is the shortest descriptor in supported firmware. */
++			if (len < 0xa) {
++				wiphy_err(priv->hw->wiphy,
++					  "firmware descriptor is too short\n");
++				return -EINVAL;
++			}
++
++			rx_start = le32_to_cpu(desc->rx_start);
++			rx_end = le32_to_cpu(desc->rx_end);
++			if (rx_end < 0x3500 || rx_end - 0x3500 <= rx_start) {
++				wiphy_err(priv->hw->wiphy,
++					  "firmware descriptor has invalid RX range\n");
++				return -EINVAL;
++			}
++
++			priv->rx_start = rx_start;
++			priv->rx_end = rx_end - 0x3500;
+ 			priv->headroom = desc->headroom;
+ 			priv->tailroom = desc->tailroom;
+ 			priv->privacy_caps = desc->privacy_caps;
