  			if ((p && (p->flags & BR_PROXYARP)) ||
  			    (dst && (dst->flags & BR_PROXYARP_WIFI)) ||
  			    br_is_neigh_suppress_enabled(dst, vid)) {
 -				if (!vid)
 +				replied = true;
